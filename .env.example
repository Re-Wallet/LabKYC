# ============================================================
# LabKYC — Configuración local
# Generado para pruebas locales. NO subir a git.
# ============================================================

# --- Base de datos ---
# Puerto 5433 = clúster local trust-mode (PostgreSQL 17)
# Puerto 5432 = docker-compose (Postgres 15)
DATABASE_URL=postgresql://labkyc:labkyc@localhost:5432/labkyc

# --- Servidor ---
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=local
APP_URL=http://localhost:8000

# --- Seguridad ---
SECRET_KEY=local_dev_secret_key_minimo_32_caracteres_x

# --- Didit (KYC) ---
# En local usamos el cliente simulado (DiditMockClient).
# Para Didit real, completar y cambiar el cliente en src/interfaces/routes/kyc.ts
DIDIT_API_KEY=local_mock_api_key
DIDIT_WORKFLOW_ID=local_mock_workflow
DIDIT_WEBHOOK_SECRET=local_mock_webhook_secret
DIDIT_API_BASE_URL=https://verification.didit.me/v3

# --- Turnkey (firmante no-custodial) ---
# En local se deriva la address de forma determinística (sin Turnkey real).
TURNKEY_API_BASE_URL=https://api.turnkey.com
TURNKEY_API_KEY=local_mock_turnkey_key

# --- Stellar Testnet ---
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Testnet SDF Network ; September 2015
STELLAR_USDC_ISSUER=local_mock_usdc_issuer
STELLAR_SPONSOR_SECRET_KEY=local_mock_sponsor_secret
STELLAR_SPONSOR_PUBLIC_KEY=GSPONSORLOCALMOCKPUBLICKEY00000000000000000000000000

# --- Claimable Balance ---
CLAIM_TTL_DAYS=30
CLAIM_TOKEN_BYTES=32
PENDING_LIMIT_USD=200

# --- Jobs ---
RECONCILIATION_INTERVAL_SECONDS=120
EXPIRATION_INTERVAL_SECONDS=3600
