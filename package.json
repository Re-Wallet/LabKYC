{
  "name": "labkyc",
  "version": "0.1.0",
  "description": "Lab KYC + Wallet no-custodial + Claimable Balance (Stellar) — arquitectura hexagonal",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=.env src/interfaces/main.ts",
    "start": "node --env-file=.env dist/interfaces/main.js",
    "build": "tsc",
    "test": "node --env-file=.env ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node --env-file=.env ./node_modules/vitest/vitest.mjs",
    "lint": "echo 'lint pendiente'",
    "typecheck": "tsc --noEmit",
    "migrate:up": "psql $DATABASE_URL -f migrations/001_init.sql"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/formbody": "^7.4.0",
    "@stellar/stellar-sdk": "^17.4.0",
    "fastify": "^4.28.1",
    "pg": "^8.11.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.11.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
